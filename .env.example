# Isloh server sozlamalari. Bu faylni ".env" nomi bilan nusxalang va to'ldiring.

# Telegram bot tokeni — @BotFather dan olinadi (@islohuzbot)
BOT_TOKEN=
BOT_USERNAME=islohuzbot

# Server manzili va porti
HOST=127.0.0.1
PORT=8080

# Ilovaning ochiq manzili (https). Telegram'dagi "Ilovani ochish" tugmalari faqat https manzil bilan ishlaydi.
# Mahalliy sinovda bo'sh qoldiring.
PUBLIC_URL=

# Ma'lumotlar papkasi (SQLite baza)
DATA_DIR=data

# Botsiz sinov kirishi (faqat shu kompyuterdan). Ishlab chiqishda 1, serverda 0.
DEV_LOGIN=0
