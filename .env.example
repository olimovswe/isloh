# Isloh sozlamalari. O'rnatish skripti bu faylni ~/.config/isloh/.env ga nusxalaydi.

# Telegram bot tokeni — @BotFather dan olinadi (@islohuzbot). Qo'yish: ~/.local/share/isloh/set-token.sh
BOT_TOKEN=
BOT_USERNAME=islohuzbot

# Ilova manzili: http://127.0.0.1:PORT (faqat shu kompyuterdan ochiladi)
PORT=8080

# Ma'lumotlar papkasi (SQLite baza)
DATA_DIR=data
