{
  "name": "isloh",
  "productName": "Isloh",
  "version": "3.0.0",
  "description": "Isloh — maqsad sari ongli hayot: namoz, kun rejasi va tahlil. Shu kompyuterdagi desktop dastur, Telegram bot bilan.",
  "author": {
    "name": "Muslimbek Olimov",
    "email": "olimovswe@gmail.com"
  },
  "homepage": "https://github.com/olimovswe/isloh",
  "repository": "github:olimovswe/isloh",
  "private": true,
  "main": "desktop/main.js",
  "desktopName": "isloh.desktop",
  "scripts": {
    "start": "electron .",
    "test": "node core/selftest.js",
    "dist": "electron-builder --linux dir"
  },
  "build": {
    "appId": "uz.olimovswe.isloh",
    "productName": "Isloh",
    "executableName": "isloh",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "core/**",
      "ui/**",
      "package.json",
      "!core/selftest.js"
    ],
    "linux": {
      "target": "dir",
      "category": "Office",
      "icon": "ui/icons/icon-512.png"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
